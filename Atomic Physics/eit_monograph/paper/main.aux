\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Comportamiento de la parte real (línea punteada) y la parte imaginaria (línea continua) de la susceptibilidad eléctrica $\chi (\Delta _p)$ cerca de resonancia para $\Omega _c = 5\text  { MHz}$. Se observacómo la absorción se va a cero en resonancia de dos fotones ($\delta = 0$); ($\Gamma _{31} = 6.0\text  { MHz}, \Gamma _{21}= 0.02\text  { MHz}, \Delta _c = 0.0 \text  {MHz}, k_0 = 1.0 \text  { cm}^{-1}$).}}{17}{figure.caption.2}\protected@file@percent }
\newlabel{fig:eit_susceptibility}{{2}{17}{Comportamiento de la parte real (línea punteada) y la parte imaginaria (línea continua) de la susceptibilidad eléctrica $\chi (\Delta _p)$ cerca de resonancia para $\Omega _c = 5\text { MHz}$. Se observacómo la absorción se va a cero en resonancia de dos fotones ($\delta = 0$); ($\Gamma _{31} = 6.0\text { MHz}, \Gamma _{21}= 0.02\text { MHz}, \Delta _c = 0.0 \text {MHz}, k_0 = 1.0 \text { cm}^{-1}$)}{figure.caption.2}{}}
