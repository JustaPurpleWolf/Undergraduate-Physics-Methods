\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Perfil del coeficiente de absorción $\alpha (\Delta _p)$ usando diferentes valores para la frecuencia del láser de control ($\Omega _c$). Se observa claramente el pozo de transparencia y cómo la ventana se hace más ancha conforme la potencia del láser de control aumenta; ($\Gamma _{31} = 6.0\text  { MHz}, \Gamma _{21}= 0.02\text  { MHz}, \Delta _c = 0.0 \text  {MHz}, k_0 = 1.0 \text  { cm}^{-1}$).}}{18}{figure.caption.3}\protected@file@percent }
\newlabel{fig:eit_absorption}{{3}{18}{Perfil del coeficiente de absorción $\alpha (\Delta _p)$ usando diferentes valores para la frecuencia del láser de control ($\Omega _c$). Se observa claramente el pozo de transparencia y cómo la ventana se hace más ancha conforme la potencia del láser de control aumenta; ($\Gamma _{31} = 6.0\text { MHz}, \Gamma _{21}= 0.02\text { MHz}, \Delta _c = 0.0 \text {MHz}, k_0 = 1.0 \text { cm}^{-1}$)}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Transmisión óptica $\mathcal  {T}$ calculada con la ley de Beer-Lambert a través de la celda de vapor atómico. Muestra cómo el medio pasa de bloquear casi toda la luz a alcanzar la transparencia en el centro de la resonancia de dos fotones; ($\Gamma _{31} = 6.0\text  { MHz}, \Gamma _{21}= 0.02\text  { MHz}, \Delta _c = 0.0 \text  {MHz}, k_0 = 1.0 \text  { cm}^{-1}, L=2.5 \text  { cm}$).}}{19}{figure.caption.4}\protected@file@percent }
\newlabel{fig:eit_transmission}{{4}{19}{Transmisión óptica $\mathcal {T}$ calculada con la ley de Beer-Lambert a través de la celda de vapor atómico. Muestra cómo el medio pasa de bloquear casi toda la luz a alcanzar la transparencia en el centro de la resonancia de dos fotones; ($\Gamma _{31} = 6.0\text { MHz}, \Gamma _{21}= 0.02\text { MHz}, \Delta _c = 0.0 \text {MHz}, k_0 = 1.0 \text { cm}^{-1}, L=2.5 \text { cm}$)}{figure.caption.4}{}}
